<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <title>Código do pagamento - Famosinhos Shop</title>
  <link rel="stylesheet" href="../css/style.css">
  <style>
    /* Estilização da página de Pix gerado com base na foto fixada */
    body {
      background: #f7f9fa;
    }
    .pix-container {
      background: #fff;
      display: flex;
      flex-direction: column;
      height: 100vh;
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
      position: relative;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .pix-header {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      border-bottom: 1px solid #eee;
      background: #fff;
    }
    .pix-header-back {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      display: flex;
      align-items: center;
    }
    .pix-header-title {
      flex: 1;
      text-align: center;
      font-size: 16px;
      font-weight: 700;
      color: #111;
      margin-right: 24px;
    }
    
    .pix-content {
      flex: 1;
      overflow-y: auto;
      padding: 20px 16px 80px 16px;
    }

    /* Bloco informativo superior */
    .pix-status-box {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
    }
    .pix-status-left {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .pix-status-title {
      font-size: 19px;
      font-weight: 800;
      color: #111;
    }
    .pix-status-price {
      font-size: 21px;
      font-weight: 800;
      color: #111;
      margin-top: 2px;
    }
    .pix-status-expire {
      font-size: 13px;
      color: #666;
      display: flex;
      align-items: center;
      gap: 4px;
      margin-top: 6px;
    }
    .pix-expire-badge {
      background: #ff2c55;
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      gap: 3px;
    }
    .pix-status-date {
      font-size: 12px;
      color: #888;
      margin-top: 2px;
    }
    .pix-status-icon-orange {
      width: 44px;
      height: 44px;
      background: #ffa726;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 24px;
      font-weight: 700;
      flex-shrink: 0;
    }

    /* Caixa do Pix Copia e Cola */
    .pix-code-box {
      background: #fff;
      border: 1px solid #ebebeb;
      border-radius: 12px;
      padding: 18px 16px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.03);
      margin-bottom: 16px;
    }
    .pix-brand-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
    }
    .pix-logo-img {
      height: 22px;
      object-fit: contain;
    }
    .pix-brand-name {
      font-size: 14px;
      font-weight: 700;
      color: #111;
    }
    .pix-textarea {
      width: 100%;
      font-size: 16px;
      color: #111;
      font-weight: 700;
      border: none;
      resize: none;
      outline: none;
      background: transparent;
      padding: 0;
      margin-bottom: 16px;
      line-height: 1.4;
      font-family: inherit;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pix-copy-btn {
      width: 100%;
      background: #ff2c55;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 14px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: background 0.2s;
    }
    .pix-copy-btn:hover {
      background: #e0244b;
    }

    /* Nota Informativa */
    .pix-instructions-note {
      font-size: 12px;
      color: #666;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    /* Como pagar */
    .pix-instructions-section {
      margin-top: 20px;
    }
    .pix-instructions-title {
      font-size: 17px;
      font-weight: 800;
      color: #111;
      margin-bottom: 12px;
    }
    .pix-instructions-desc {
      font-size: 13px;
      color: #444;
      line-height: 1.6;
    }

    /* Footer Fixado */
    .pix-footer {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      padding: 12px 16px 20px 16px;
      background: #fff;
      border-top: 1px solid #eee;
      box-sizing: border-box;
      z-index: 10;
    }
    .pix-btn-ver-pedido {
      width: 100%;
      background: #f5f5f5;
      color: #222;
      border: none;
      border-radius: 8px;
      padding: 13px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      transition: background 0.2s;
    }
    .pix-btn-ver-pedido:hover {
      background: #e8e8e8;
    }

    /* Modal de Lista de Produtos do Pedido */
    .pedido-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      height: 100vh;
      background: #f7f9fa;
      z-index: 99999;
      overflow-y: auto;
      flex-direction: column;
    }
    .pedido-modal-header {
      background: #fff;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid #eee;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .pedido-modal-title {
      flex: 1;
      text-align: center;
      font-size: 16px;
      font-weight: 700;
      color: #111;
      margin-right: 24px;
    }
    .pedido-modal-content {
      padding: 16px;
      flex: 1;
    }
    .pedido-card {
      background: #fff;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
    .pedido-store-name {
      font-size: 13px;
      font-weight: 700;
      color: #111;
      margin-bottom: 12px;
    }
    .pedido-item-row {
      display: flex;
      gap: 12px;
      margin-bottom: 12px;
    }
    .pedido-item-img {
      width: 64px;
      height: 64px;
      border-radius: 8px;
      object-fit: cover;
      border: 1px solid #f0f0f0;
    }
    .pedido-item-details {
      flex: 1;
    }
    .pedido-item-name {
      font-size: 13px;
      color: #222;
      font-weight: 500;
      line-height: 1.4;
    }
    .pedido-item-var {
      font-size: 11px;
      color: #888;
      margin-top: 4px;
    }
    .pedido-item-price-qty {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 8px;
    }
    .pedido-item-price {
      font-size: 14px;
      font-weight: 700;
      color: #111;
    }
    .pedido-item-qty {
      font-size: 12px;
      color: #666;
    }
  </style>
</head>
<body>

<div class="pix-container">
  
  <!-- HEADER -->
  <header class="pix-header">
    <button class="pix-header-back" onclick="window.location.href='resumo.html'">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#222" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <div class="pix-header-title">Código do pagamento</div>
  </header>

  <!-- CONTEÚDO PRINCIPAL -->
  <div class="pix-content">
    
    <!-- Status do pedido -->
    <div class="pix-status-box">
      <div class="pix-status-left">
        <div class="pix-status-title">Aguardando o pagamento</div>
        <div class="pix-status-price" id="pix-total-price">R$ 0,00</div>
        <div class="pix-status-expire">
          <span>Vence em</span>
          <div class="pix-expire-badge">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#fff" stroke-width="3" style="margin-top: 1px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span id="pix-countdown">23:59:59</span>
          </div>
        </div>
        <div class="pix-status-date" id="pix-deadline-date">09:27, 29 de jun 2026</div>
      </div>
      <!-- Reloginho Laranja -->
      <div class="pix-status-icon-orange">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
    </div>

    <!-- Bloco Copia e Cola -->
    <div class="pix-code-box">
      <div class="pix-brand-row">
        <img class="pix-logo-img" src="../logopix/image.png" onerror="this.style.display='none'" alt="Pix">
        <span class="pix-brand-name">PIX</span>
      </div>
      <input type="text" class="pix-textarea" id="pix-code-text" readonly value="00020101021226870014br.gov.bcb.pix25650021qrpix-h.sigilopay.com/v2/01b87a8761bf4604928f2">
      <button class="pix-copy-btn" onclick="copyPixCode()">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        Copiar
      </button>
    </div>

    <!-- Texto explicativo cinza -->
    <div class="pix-instructions-note">
      Para acessar esta página no app, abra <strong>Loja &gt; Pedidos &gt; Sem pagamento &gt; Visualizar o código</strong>
    </div>

    <!-- Como pagar com pix -->
    <div class="pix-instructions-section">
      <div class="pix-instructions-title">Como fazer pagamentos com PIX?</div>
      <div class="pix-instructions-desc">
        Copie o código de pagamento acima, selecione Pix no seu app de internet ou de banco e cole o código.
      </div>
    </div>

  </div>

  <!-- FOOTER FIXADO -->
  <footer class="pix-footer">
    <button class="pix-btn-ver-pedido" onclick="openPedidoModal()">Ver pedido</button>
  </footer>

</div>

<!-- MODAL DE LISTA DE PRODUTOS -->
<div class="pedido-modal" id="pedido-modal-box">
  <div class="pedido-modal-header">
    <button class="pix-header-back" onclick="closePedidoModal()">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#222" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <div class="pedido-modal-title">Detalhes do Pedido</div>
  </div>
  <div class="pedido-modal-content">
    <div class="pedido-card">
      <div class="pedido-store-name">Famosinhos Shop</div>
      <div id="pedido-items-list">
        <!-- Preenchido via Javascript -->
      </div>
    </div>
  </div>
</div>

<script>
// Pega os itens do carrinho e totais do localStorage
function getCart() {
  try {
    return JSON.parse(localStorage.getItem('famosinhos_cart') || '[]');
  } catch(e) {
    return [];
  }
}

function renderPedidoItems() {
  const cart = getCart();
  const listEl = document.getElementById('pedido-items-list');
  if (!listEl) return;
  
  if (!cart.length) {
    listEl.innerHTML = '<p style="color:#888;font-size:13px;text-align:center;">Nenhum produto cadastrado no pedido.</p>';
    return;
  }
  
  let html = '';
  let subtotal = 0;
  cart.forEach(item => {
    const qty = item.qty || 1;
    const price = typeof item.preco === 'number' ? item.preco : parseFloat(String(item.preco).replace(',','.'));
    const itemTotal = price * qty;
    subtotal += itemTotal;
    
    html += `
      <div class="pedido-item-row">
        <img class="pedido-item-img" src="${item.img.startsWith('../') ? item.img : '../' + item.img}" onerror="this.src='https://via.placeholder.com/64'">
        <div class="pedido-item-details">
          <div class="pedido-item-name">${item.nome}</div>
          ${item.variacao ? `<div class="pedido-item-var">${item.variacao}</div>` : ''}
          <div class="pedido-item-price-qty">
            <span class="pedido-item-price">R$ ${price.toFixed(2).replace('.', ',')}</span>
            <span class="pedido-item-qty">x${qty}</span>
          </div>
        </div>
      </div>
    `;
  });
  
  listEl.innerHTML = html;
  
  // Total com desconto do cupom fixo de R$ 5,00
  const finalTotal = Math.max(0, subtotal - 5.00);
  document.getElementById('pix-total-price').textContent = 'R$ ' + finalTotal.toFixed(2).replace('.', ',');
}

// Relógio regressivo 24h
function startRegressivo() {
  let time = 24 * 3600 - 1;
  const countEl = document.getElementById('pix-countdown');
  
  setInterval(() => {
    let hours = Math.floor(time / 3600);
    let minutes = Math.floor((time % 3600) / 60);
    let seconds = time % 60;
    
    let hStr = hours < 10 ? '0' + hours : hours;
    let mStr = minutes < 10 ? '0' + minutes : minutes;
    let sStr = seconds < 10 ? '0' + seconds : seconds;
    
    if (countEl) countEl.textContent = hStr + ':' + mStr + ':' + sStr;
    time--;
    if (time < 0) time = 24 * 3600 - 1;
  }, 1000);
}

// Data limite (24h no futuro)
function setDeadlineDate() {
  const now = new Date();
  now.setDate(now.getDate() + 1);
  const dia = now.getDate() < 10 ? '0' + now.getDate() : now.getDate();
  const meses = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
  const mes = meses[now.getMonth()];
  const ano = now.getFullYear();
  const hora = now.getHours() < 10 ? '0' + now.getHours() : now.getHours();
  const min = now.getMinutes() < 10 ? '0' + now.getMinutes() : now.getMinutes();
  
  document.getElementById('pix-deadline-date').textContent = `${hora}:${min}, ${dia} de ${mes} de ${ano}`;
}

function copyPixCode() {
  const code = document.getElementById('pix-code-text').value;
  navigator.clipboard.writeText(code).then(() => {
    alert('Código Pix copiado com sucesso!');
  }).catch(() => {
    // Fallback
    const input = document.getElementById('pix-code-text');
    input.select();
    document.execCommand('copy');
    alert('Código Pix copiado com sucesso!');
  });
}

function openPedidoModal() {
  document.getElementById('pedido-modal-box').style.display = 'flex';
}

function closePedidoModal() {
  document.getElementById('pedido-modal-box').style.display = 'none';
}

// Inicializações
renderPedidoItems();
startRegressivo();
setDeadlineDate();
</script>

</body>
</html>